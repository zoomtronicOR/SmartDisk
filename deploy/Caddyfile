# SmartDisk – generiše deploy/install.sh (__SITES__ se zamenjuje adresama kontejnera).
# `tls internal` koristi lokalni Caddy CA; za pouzdan sertifikat u pregledaču instalirati
# /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt kao pouzdan CA.
__SITES__ {
	tls internal
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /opt/smartdisk/frontend/dist
		@static path /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
