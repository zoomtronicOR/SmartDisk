# SmartDisk konfiguracija (/etc/smartdisk/smartdisk.env, vlasnik root:smartdisk, prava 640).
# install.sh pri prvoj instalaciji generiše master ključ. Bez njega šifrovani SSH ključevi ne mogu da se pročitaju –
# čuvati rezervnu kopiju odvojeno od backup-a baze.
SMARTDISK_MASTER_KEY=

# Baza preko unix socket-a (peer autentifikacija, bez lozinke).
SMARTDISK_DATABASE_URL=postgresql+asyncpg://smartdisk@/smartdisk?host=/var/run/postgresql

# Sesije
SMARTDISK_SESSION_IDLE_MINUTES=30
SMARTDISK_SESSION_MAX_HOURS=12
SMARTDISK_COOKIE_SECURE=true

# Zaštita prijave
SMARTDISK_LOGIN_MAX_FAILURES=5
SMARTDISK_LOGIN_LOCK_MINUTES=15

# SSH prikupljanje
SMARTDISK_MAX_PARALLEL_SSH=4

SMARTDISK_LOG_LEVEL=INFO
